# 로컬 개발용 기본값입니다. 사용법: cp .env.example .env
# DB·Redis·RabbitMQ 값은 로컬 전용이라 그대로 써도 됩니다 (infra/docker-compose.local.yml과 같은 값).
# 비밀 키(JWT·AWS·외부 API)는 팀 내부에서 따로 공유하며, .env는 절대 커밋하지 마세요.
# 서버용 .env는 Jenkins Credentials(audisay-env)로 따로 관리합니다.

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=audisay
POSTGRES_USER=audisay
POSTGRES_PASSWORD=audisay

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=audisay

# ===== RabbitMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=audisay
RABBITMQ_DEFAULT_PASS=audisay

# ===== JWT =====
JWT_SECRET=

# ===== AWS S3 =====
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== 외부 API =====
GMS_API_KEY=
TTS_API_KEY=
