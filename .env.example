# 로컬 개발용 기본값입니다. 사용법: cp .env.example .env
# DB·Redis·RabbitMQ 값은 로컬 전용이라 그대로 써도 됩니다 (infra/docker-compose.local.yml과 같은 값).
# 비밀 키(AWS·외부 API)는 팀 내부에서 따로 공유하며, .env는 절대 커밋하지 마세요.
# 로컬 실행·테스트 때 백엔드가 이 파일(.env)을 직접 읽습니다 (application.yml의 spring.config.import).
# 서버용 .env는 Jenkins Credentials(audisay-env)로 따로 관리합니다.

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=audisay
POSTGRES_USER=audisay
POSTGRES_PASSWORD=audisay

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=audisay

# ===== RabbitMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=audisay
RABBITMQ_DEFAULT_PASS=audisay

# ===== JWT =====
# 로컬 전용 공용 값이라 그대로 써도 됩니다. 서버 값은 Jenkins Credentials(audisay-env)에 다른 값으로 둡니다
JWT_SECRET=XdV/GbCqpKLI1gxWMf8raTw9boq6ek0XMk2GWZBKXONezFWd7jUhbvLqLik4Ly9O
# 만료 시간: 30m·1h·14d 같은 단위 또는 밀리초
JWT_ACCESS_EXP=1h
JWT_REFRESH_EXP=14d

# ===== AWS S3 =====
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== 외부 API =====
# YouTube Data API v3 키. 하루 한도가 키마다 따로라 로컬은 각자 Google Cloud에서 발급해 넣습니다
YOUTUBE_API_KEY=
GMS_API_KEY=
GMS_GEMINI_BASE_URL=
TTS_API_KEY=

# ===== AI 서버 =====
# Spring이 AI 서버 내부 API(/internal/*)를 부를 때 X-Internal-Token 헤더로 보내는 공유 비밀
AI_INTERNAL_TOKEN=
# AI 서버가 받을 큐 (쉼표로 구분)
WORKER_QUEUES=job.prepare,job.describe

# ===== Grafana (서버 관제) =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
